{
  "name": "kiddo-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:equipment && next build",
    "start": "next start",
    "lint": "next lint",
    "validate:equipment": "tsx scripts/validate-equipment.ts",
    "check:quote": "tsx scripts/check-quote.ts",
    "sync:photos": "node scripts/fetch-equipment-photos.mjs",
    "check:dates": "tsx scripts/check-dates.ts",
    "check:availability": "tsx scripts/check-availability.ts",
    "admin:hash": "tsx scripts/admin-hash.ts",
    "check:admin": "tsx scripts/check-admin.ts",
    "check:contact": "tsx scripts/check-contact.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.ts",
    "check:holds": "tsx --env-file-if-exists=.env.local scripts/check-holds.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "next": "^15.3.1",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
